<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.example.rpm_pr_1.controller.GradeController">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Учёт студентов и успеваемости" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24" visible="false"/>
        <Label fx:id="lblStatus" text="Готово"/>
    </HBox>
    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colName" text="ФИО" prefWidth="200"/>
                    <TableColumn fx:id="colGroup" text="Группа" prefWidth="100"/>
                    <TableColumn fx:id="colAvgGrade" text="Средний балл" prefWidth="100"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnPreviousPage" text="Назад" onAction="#handlePreviousPage"/>
                <Label fx:id="lblPage" text="Страница 1 из 1"/>
                <Button fx:id="btnNextPage" text="Далее" onAction="#handleNextPage"/>
            </HBox>
        </VBox>
        <VBox spacing="20" prefWidth="300">
            <VBox spacing="5" style="-fx-border-color: #ccc; -fx-padding: 10; -fx-border-radius: 5;">
                <Label text="Добавить студента" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtStudentName" promptText="ФИО студента"/>
                <TextField fx:id="txtGroupName" promptText="Группа"/>
                <Button text="Добавить" onAction="#handleAddStudent" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="5" style="-fx-border-color: #ccc; -fx-padding: 10; -fx-border-radius: 5;">
                <Label text="Добавить предмет" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtSubjectTitle" promptText="Предмет"/>
                <Button text="Добавить" onAction="#handleAddSubject" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="5" style="-fx-border-color: #ccc; -fx-padding: 10; -fx-border-radius: 5;">
                <Label text="Поставить оценку" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="comboStudents" promptText="Студент" maxWidth="Infinity"/>
                <ComboBox fx:id="comboSubjects" promptText="Предмет" maxWidth="Infinity"/>
                <TextField fx:id="txtGradeValue" promptText="Оценка"/>
                <Button text="Сохранить оценку" onAction="#handleAddGrade" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
